<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+. Token sesi tidak ikut backup cloud maupun transfer perangkat. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="auth_session.xml" />
        <exclude domain="sharedpref" path="com.wahyuakbarwibowo.aminmartkasir_preferences.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="auth_session.xml" />
        <exclude domain="sharedpref" path="com.wahyuakbarwibowo.aminmartkasir_preferences.xml" />
    </device-transfer>
</data-extraction-rules>
